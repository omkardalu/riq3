# Copy to .env and edit. Never commit .env.
# Development works with just these:
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://riq:riq@localhost:5432/riq
TEST_DATABASE_URL=postgresql://riq:riq@localhost:5432/riq_test

# Optional (defaults shown)
# UPLOAD_FOLDER=./instance/uploads
# MAX_RESUME_BYTES=5242880              # 5 MB per resume
# USER_STORAGE_QUOTA_BYTES=524288000    # 500 MB per company account
# LOG_LEVEL=INFO

# Production only - see DEPLOYMENT.md. Leave these commented in development:
# (generate a key with: python -c "import secrets; print(secrets.token_hex(32))")
# APP_ENV=production
# SESSION_COOKIE_SECURE=true            # requires HTTPS; the app refuses to start in production without it
# TRUST_PROXY=true                      # when behind nginx / a platform proxy
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0   # needed with more than one worker
