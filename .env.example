# Copy to .env and edit. Never commit .env.
APP_ENV=development                     # development | production
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql://riq:riq@localhost:5432/riq
TEST_DATABASE_URL=postgresql://riq:riq@localhost:5432/riq_test

# Uploads (stored privately, outside the web root)
UPLOAD_FOLDER=./instance/uploads
MAX_RESUME_BYTES=5242880                # 5 MB per resume
USER_STORAGE_QUOTA_BYTES=524288000      # 500 MB per company account

# Production only
SESSION_COOKIE_SECURE=true              # requires HTTPS
TRUST_PROXY=false                       # true when behind nginx/Render/Heroku-style proxy
RATELIMIT_STORAGE_URI=memory://         # use redis://... with more than one worker
LOG_LEVEL=INFO
